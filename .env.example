# Copy this file to .env and fill in real values. Never commit .env.

# --- API ---
PORT=3000
NODE_ENV=development
# The single browser origin allowed by CORS (your frontend URL).
CORS_ORIGIN=http://localhost:5173
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200

# --- Auth ---
# Generate each secret with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=1h
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=7d

# --- Database (read by docker-compose) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=issue_tracker
DB_PORT=5432

# --- Database URL for running the API on your machine, outside Docker ---
# Must match the values above.
DATABASE_URL=postgres://postgres:YOUR_POSTGRES_PASSWORD@localhost:5432/issue_tracker
